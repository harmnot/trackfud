# Trackfud customer PWA — copy to `.env` and fill in.
# Only VITE_* keys are exposed to the browser. Never put secrets here.

# Backend base URL. Default when unset: /api/v1 (gateway/Vite proxy).
# Local dev without gateway (backend on :8081): http://localhost:8081/v1
VITE_API_BASE=/api/v1

# Paddle client token (sandbox). Empty = card UI falls back to wallet-only
# with a "not configured" message; wallet pay always works.
VITE_PADDLE_CLIENT_TOKEN=
# sandbox (default) or production
VITE_PADDLE_ENV=sandbox

# Google Maps browser key (restricted to app origin via HTTP referrer).
# Not used yet — LiveMap is schematic until the @vis.gl swap-in.
# VITE_GOOGLE_MAPS_KEY=
