# Trackfud customer PWA — copy to `.env` and fill in.
# Only VITE_* keys are exposed to the browser. Never put secrets here.

# Backend base URL. Default when unset: /api/v1 (gateway/Vite proxy).
# Local dev without gateway (backend on :8081): http://localhost:8081/v1
VITE_API_BASE=/api/v1

# Paddle client token (sandbox). Empty = card UI falls back to wallet-only
# with a "not configured" message; wallet pay always works. The app also reads
# GET /v1/config/public as a fallback, so only set this when the build must
# pin an env (it must match the dashboard app TF_PADDLE_ENV points at).
VITE_PADDLE_CLIENT_TOKEN=
# sandbox (default) or production
VITE_PADDLE_ENV=sandbox
# Server side (backend/.env, never here): TF_PADDLE_API_KEY mints the Paddle
# transaction for each top-up / card order (POST /customer/payments/{id}/checkout).
# Without it the overlay cannot open (Paddle Billing rejects amount-only items
# with `required price_id`); demo mode (TF_DEMO_MODE=true) confirms instantly
# via POST /dev/payments/{id}/simulate-paid instead.

# Google Maps browser key (HTTP-referrer restricted to the app origin —
# a public key, never a secret; the server key TF_GOOGLE_MAPS_KEY stays in
# backend/.env with an IP restriction). Powers live maps and pin pickers;
# without it they render a schematic fallback. Restart `pnpm dev` after adding it.
VITE_GOOGLE_MAPS_KEY=
# Optional Cloud Console map id for advanced markers (vector map).
# Leave empty for classic markers (works on any key, no console setup).
VITE_GOOGLE_MAPS_MAP_ID=
