---
import { navLinks } from '../data/content';
---

<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="wordmark" href="#top" aria-label="Trackfud — back to top">
      <span class="wordmark-name">Trackfud</span>
      <span class="wordmark-slogan">run. ride. earn</span>
    </a>
    <nav class="main-nav" aria-label="Main">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="btn btn-ghost btn-sm hide-mobile" href="#browser">No download needed</a>
      <a class="btn btn-white btn-sm" href="#get-started">Get started</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-btn aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" data-mobile-nav hidden>
    {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="#get-started">Get started</a>
  </nav>
</header>

<script>
  const btn = document.querySelector('[data-menu-btn]');
  const panel = document.querySelector('[data-mobile-nav]');
  btn?.addEventListener('click', () => {
    const open = panel?.hasAttribute('hidden');
    if (open) { panel?.removeAttribute('hidden'); btn.setAttribute('aria-expanded', 'true'); }
    else { panel?.setAttribute('hidden', ''); btn.setAttribute('aria-expanded', 'false'); }
  });
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    panel.setAttribute('hidden', ''); btn?.setAttribute('aria-expanded', 'false');
  }));
</script>

<style>
  .site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 60; transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s; border-bottom: 1px solid transparent; }
  .site-header.scrolled { background: rgba(6, 7, 9, 0.82); backdrop-filter: blur(18px) saturate(1.3); border-bottom-color: var(--tb-soft-line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 0; }
  .wordmark { text-decoration: none; display: flex; flex-direction: column; line-height: 1; }
  .wordmark-name { font-weight: 800; font-size: 1.3rem; letter-spacing: -0.03em; }
  .wordmark-slogan { font-family: var(--tb-serif); font-style: italic; font-size: 0.72rem; color: var(--tb-muted); margin-top: 0.2rem; letter-spacing: 0.01em; }
  .main-nav { display: flex; gap: 1.6rem; }
  .main-nav a { text-decoration: none; font-size: 0.88rem; font-weight: 600; color: var(--tb-muted); transition: color 0.2s; position: relative; padding: 0.3rem 0; }
  .main-nav a::after { content: ""; position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: #fff; transform: scaleX(0); transform-origin: right; transition: transform 0.3s var(--tb-ease); }
  .main-nav a:hover { color: var(--tb-ink); }
  .main-nav a:hover::after { transform: scaleX(1); transform-origin: left; }
  .header-actions { display: flex; align-items: center; gap: 0.6rem; }
  .btn-sm { min-height: 42px; padding: 0 1.1rem; font-size: 0.87rem; }
  .menu-btn { display: none; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--tb-line); background: rgba(255,255,255,0.04); color: var(--tb-ink); cursor: pointer; place-items: center; }
  .menu-btn svg { width: 19px; height: 19px; }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.6rem 1.25rem 1.1rem; background: rgba(6,7,9,0.96); backdrop-filter: blur(18px); border-bottom: 1px solid var(--tb-soft-line); }
  .mobile-nav a { text-decoration: none; font-weight: 600; font-size: 0.98rem; padding: 0.65rem 0.2rem; border-bottom: 1px solid var(--tb-soft-line); }
  .mobile-nav a:last-child { border-bottom: none; }
  @media (max-width: 900px) {
    .main-nav { display: none; }
    .menu-btn { display: grid; }
  }
  @media (max-width: 560px) { .hide-mobile { display: none; } }
  @media (max-width: 480px) {
    .wordmark-name { font-size: 1.08rem; }
    .wordmark-slogan { font-size: 0.64rem; }
    .header-actions .btn-sm { min-height: 38px; padding: 0 0.85rem; font-size: 0.8rem; }
    .menu-btn { width: 38px; height: 38px; }
  }
</style>
