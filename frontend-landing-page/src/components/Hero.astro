---
import PhoneMock from './PhoneMock.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <img src="/images/hero-runner.jpg" alt="" fetchpriority="high" />
    <div class="hero-shade"></div>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-badge"><span class="badge-dot"></span> No download · Works in your browser · For customers, couriers & merchants</p>
      <h1 class="hero-title" id="hero-title">
        <span class="line"><span>Run.</span></span>
        <span class="line"><span>Ride.</span></span>
        <span class="line"><span>Earn.</span></span>
      </h1>
      <p class="lede hero-lede">
        Trackfud turns a workout you were already doing into a food delivery.
        Runners and bikers carry real orders on their route and get paid for
        every trip — customers order in the browser, merchants cook, nobody
        downloads an app.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-white" href="#couriers">Start earning
          <svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
        </a>
        <a class="btn btn-ghost" href="#customers">Order food</a>
        <a class="btn btn-ghost" href="#merchants">Sell on Trackfud</a>
      </div>
      <ul class="hero-proof">
        <li><strong>No app store.</strong> Opens in your browser, adds to your home screen.</li>
        <li><strong>Three roles, one platform.</strong> Customer, courier and merchant — each in its own browser page.</li>
      </ul>
    </div>

    <div class="hero-visual" aria-label="Trackfud app preview on phones">
      <div class="phone-back phone-back-left"><PhoneMock variant="customer" /></div>
      <div class="phone-main"><PhoneMock variant="courier" /></div>
      <div class="phone-back phone-back-right"><PhoneMock variant="merchant" /></div>
      <div class="float-chip chip-earn">
        <span class="chip-label">Delivery complete</span>
        <strong>+ Rp 16.000 earned</strong>
      </div>
      <div class="float-chip chip-live">
        <span class="live-dot-wrap"><span class="live-ping"></span><span class="live-core"></span></span>
        <span><strong>Live tracking</strong><small>420 m away · on route</small></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding: clamp(7.5rem, 14vw, 10rem) 0 clamp(4rem, 8vw, 6rem); overflow: hidden; isolation: isolate; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 72% 38%; animation: kenburns 22s ease-in-out infinite alternate; opacity: 0.52; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(6,7,9,0.96) 0%, rgba(6,7,9,0.88) 42%, rgba(6,7,9,0.42) 72%, rgba(6,7,9,0.66) 100%), linear-gradient(0deg, var(--tb-bg) 0%, transparent 32%), linear-gradient(180deg, rgba(6,7,9,0.72) 0%, transparent 30%); }
  .hero-grid { display: grid; grid-template-columns: 1.02fr 0.98fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero-badge { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; font-weight: 600; color: var(--tb-body); background: rgba(255,255,255,0.05); border: 1px solid var(--tb-line); border-radius: 999px; padding: 0.45rem 0.9rem; margin: 0 0 1.4rem; backdrop-filter: blur(8px); }
  .badge-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--tb-good); animation: pulse-dot 2.2s ease-in-out infinite; }
  .hero-title { font-family: var(--tb-serif); font-weight: 500; font-size: clamp(4rem, 11vw, 7.5rem); line-height: 0.92; letter-spacing: -0.035em; margin: 0; }
  .hero-title .line { display: block; overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .hero-title .line > span { display: inline-block; animation: hero-line 0.9s var(--tb-ease) both; }
  .hero-title .line:nth-child(2) > span { animation-delay: 0.12s; font-style: italic; color: var(--tb-muted); }
  .hero-title .line:nth-child(3) > span { animation-delay: 0.24s; }
  .hero-lede { max-width: 34rem; margin: 1.5rem 0 0; font-size: 1.08rem; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 2rem; }
  .hero-proof { list-style: none; margin: 2rem 0 0; padding: 1.2rem 0 0; border-top: 1px solid var(--tb-line); display: grid; gap: 0.5rem; color: var(--tb-muted); font-size: 0.9rem; max-width: 34rem; }
  .hero-proof strong { color: var(--tb-ink); }
  .hero-visual { position: relative; min-height: 600px; display: flex; align-items: center; justify-content: center; }
  .phone-main { position: relative; z-index: 3; animation: floaty 7s ease-in-out infinite; --rot: 0deg; }
  .phone-back { position: absolute; top: 50%; opacity: 0.92; filter: saturate(0.85); }
  .phone-back :global(.phone) { width: clamp(158px, 23vw, 218px); }
  .phone-back-left { left: -6px; transform: translateY(-54%) rotate(-7deg); z-index: 1; animation: floaty 8s ease-in-out infinite; --rot: -7deg; }
  .phone-back-right { right: -6px; transform: translateY(-46%) rotate(7deg); z-index: 2; animation: floaty 9s ease-in-out 0.6s infinite; --rot: 7deg; }
  .float-chip { position: absolute; z-index: 4; background: rgba(13,14,17,0.92); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.16); border-radius: 16px; padding: 0.75rem 1rem; box-shadow: var(--tb-sh-card); display: flex; gap: 0.6rem; align-items: center; animation: chip-in 0.8s var(--tb-ease) both; }
  .chip-earn { left: 0; bottom: 9%; flex-direction: column; align-items: flex-start; gap: 0.1rem; animation-delay: 0.7s; }
  .chip-earn strong { font-size: 0.98rem; letter-spacing: -0.01em; }
  .chip-label { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #6ee7b7; }
  .chip-live { right: 0; top: 7%; animation-delay: 0.9s; font-size: 0.82rem; }
  .chip-live small { display: block; color: var(--tb-muted); font-size: 0.7rem; font-weight: 500; }
  .live-dot-wrap { position: relative; width: 12px; height: 12px; flex-shrink: 0; }
  .live-core { position: absolute; inset: 2px; border-radius: 50%; background: var(--tb-good); }
  .live-ping { position: absolute; inset: 0; border-radius: 50%; background: rgba(52,211,153,0.5); animation: ping-soft 2s ease-out infinite; }
  @media (max-width: 1020px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { min-height: 560px; margin-top: 1rem; }
    .hero-bg img { object-position: 65% 30%; opacity: 0.4; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 6.2rem; }
    .hero-visual { min-height: 0; padding: 1rem 0 2.6rem; }
    .phone-main :global(.phone) { width: min(264px, 72vw); }
    .phone-back :global(.phone) { width: clamp(118px, 36vw, 150px); }
    .phone-back-left { left: -26px; }
    .phone-back-right { right: -26px; }
    .float-chip { padding: 0.6rem 0.75rem; font-size: 0.78rem; border-radius: 13px; }
    .chip-earn { left: 0; bottom: 0; }
    .chip-live { right: 0; top: 0; }
  }
  @media (max-width: 480px) {
    .hero-title { font-size: clamp(3.1rem, 15.5vw, 3.9rem); }
    .hero-badge { font-size: 0.7rem; line-height: 1.45; }
    .hero-ctas { flex-direction: column; align-items: stretch; }
    .hero-ctas .btn { width: 100%; }
    .hero-proof { font-size: 0.84rem; }
  }
</style>
