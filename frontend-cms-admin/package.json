{
    "name": "frontend-cms-admin",
    "version": "1.0.0",
    "description": "Trackfud back-office admin CMS — approve couriers and merchants, monitor live orders on the map, refunds, payouts, platform settings, audit log and AI ops. Admin login required.",
    "keywords": [
      "trackfud",
      "admin-dashboard",
      "back-office",
      "operations-dashboard",
      "courier-approval",
      "merchant-approval",
      "order-monitoring",
      "refunds",
      "payouts",
      "audit-log"
    ],
    "homepage": "https://trackfud.netlify.app/",
    "packageManager": "pnpm@12.16.1",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "smoke": "node scripts/route-smoke.mjs",
        "guards": "node scripts/guard-smoke.mjs"
    },
    "author": "Muhammad",
    "type": "module",
    "dependencies": {
        "@tanstack/react-query": "5.105.0",
        "dexie": "4.4.7",
        "openapi-fetch": "0.17.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "8.5.0",
        "zustand": "5.0.16"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.3",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "6.1.2",
        "openapi-typescript": "7.13.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vite-plugin-pwa": "2.0.0",
        "workbox-precaching": "^7.3.0",
        "workbox-routing": "^7.3.0",
        "workbox-strategies": "^7.3.0",
        "workbox-window": "7.4.1"
    }
}