# Trackfud backend — copy to `.env` and fill in. Every key maps to an
# os.Getenv read in backend/internal/config/config.go. Safe to commit this
# file WITHOUT secrets; never commit a filled `.env`.

# Postgres (PostGIS). Compose default:
DATABASE_URL=postgres://Trackfud:Trackfud@localhost:5432/Trackfud?sslmode=disable
# Optional: alternate config file path (default: config.yaml next to binary)
# TF_CONFIG=config.yaml
# Optional: listen addr (default :8080)
# TF_ADDR=:8080
# Canonical environment switch: APP_DEVELOPMENT=production means production
# mode (no demo shortcuts: no demo-login, no dev simulate-paid). local,
# development, or demo mean local/demo mode for now. Precedence: an explicit
# TF_DEMO_MODE wins when set (compat); then an explicit APP_DEVELOPMENT
# (production → false, anything else → true); otherwise the config.yaml value.
# APP_DEVELOPMENT=production
TF_DEMO_MODE=true

# Auth: MUST be >= 32 chars in any shared/demo environment
TF_JWT_SECRET=dev-only-change-me-32chars-minimum!!
# Optional: dedicated AES-GCM key for sealing courier ID numbers. When set it
# replaces the JWT-secret-derived key for new seals; rotation-safe (sealed
# values are write-only, dup detection uses the hash). Empty = derived key.
# TF_IDENC_KEY=

# Public origin of the API gateway (no trailing slash). Used to build the
# Paddle webhook URL: $TF_PUBLIC_BASE_URL/api/v1/webhooks/paddle — register
# that exact URL in the Paddle sandbox dashboard (Notifications > Destinations).
TF_PUBLIC_BASE_URL=http://localhost:8000

# Paddle sandbox. Webhook refuses everything while the secret is empty.
TF_PADDLE_WEBHOOK_SECRET=
# Server-side Paddle API key (sandbox) for future capture/refund lookups;
# the webhook flow works on the secret alone.
TF_PADDLE_API_KEY=
# sandbox (default) or production. Must match the dashboard app the webhook
# secret and the frontend client token come from.
TF_PADDLE_ENV=sandbox
# Paddle.js client token (sandbox) — also set as VITE_PADDLE_CLIENT_TOKEN in
# frontend-customer/.env. Public by design (browser key, not a secret).
TF_PADDLE_CLIENT_TOKEN=

# --- Files: Cloudflare R2 (S3-compatible) in prod, local disk in dev ---
# With TF_R2_ENDPOINT set, presign returns R2 presigned PUT/GET URLs (5-min
# expiry): TF_R2_PUBLIC_BUCKET holds menus/avatars, TF_R2_PRIVATE_BUCKET
# holds IDs/selfie/proof/agreements (presigned GET only, never proxied).
# Empty endpoint = local UploadDir fallback (dev/tests).
TF_R2_ENDPOINT=
TF_R2_ACCESS_KEY=
TF_R2_SECRET_KEY=
TF_R2_PUBLIC_BUCKET=
TF_R2_PRIVATE_BUCKET=
# Optional bucket-bound public base (custom domain or https://pub-<hash>.r2.dev)
# for the public bucket. Leave empty — or set to the same R2 endpoint — and
# public files are served via 5-min presigned URLs off the raw endpoint instead.
TF_R2_PUBLIC_URL=
# Local upload dir for the dev fallback only.
TF_UPLOAD_DIR=data/uploads

# SMTP: Brevo in prod (smtp-relay.brevo.com:587 + API-key user/pass), Mailpit
# locally (compose exposes 1025/8025). Empty user = no-auth dev path.
TF_SMTP_HOST=localhost
TF_SMTP_PORT=1025
TF_SMTP_USER=
TF_SMTP_PASSWORD=
TF_SMTP_FROM=no-reply@Trackfud.local

# Web Push VAPID pair (P-256). The two keys are ONE matched pair: generate
# once, keep them together, and never hand-type or invent them. Random text
# fails boot now (fail-fast validation) and previously broke push silently —
# every queued push failed at the browser push service.
#
# Generate (run once, anywhere with Node — no install needed):
#   npx -y web-push generate-vapid-keys
# It prints two lines; copy them exactly (no quotes, no spaces):
#   Public Key:  BH... (~87 chars, base64url)
#   Private Key: Xy... (~43 chars, base64url)
#   TF_VAPID_PUBLIC_KEY=<paste Public Key>
#   TF_VAPID_PRIVATE_KEY=<paste Private Key>
#
# Rules:
# - Both lines come from the SAME output. Mixing keys from two runs fails
#   boot ("does not derive"). Regenerating later is fine, but every
#   previously-subscribed browser must re-subscribe (old subscriptions were
#   encrypted to the old key; the app re-asks on next visit).
# - Frontends need NOTHING: they fetch the public key live from
#   GET /api/v1/push/vapid-public-key at subscribe time.
# - Leave BOTH empty for local dev: the server auto-creates a stable DB dev
#   pair in app_secrets (per database). Set the env pair for any shared /
#   staging / prod setup so every replica and restart shares one key.
# - TF_VAPID_SUBJECT must be mailto:you@example.com or https://your-domain
#   (browsers / push services require a contact URL).
# - After editing backend/.env, restart the backend so the container picks
#   the keys up (scripts/podman-up.sh forwards TF_VAPID_*), then verify:
#   curl http://localhost:8000/api/v1/push/vapid-public-key
#   must print your TF_VAPID_PUBLIC_KEY.
TF_VAPID_PUBLIC_KEY=
TF_VAPID_PRIVATE_KEY=
TF_VAPID_SUBJECT=mailto:demo@Trackfud.local

# Google Routes API (server key, restricted to server IP). Empty = offline
# planning-speed estimate fallback.
TF_GOOGLE_MAPS_KEY=

# --- AI: Modal-hosted chat/text (default) + Meta direct fallback ---
# Credentials never leave the server. No credential = deterministic offline
# fallbacks (demo still works).
#
# Modal proxy auth is ONE Bearer token "<token-id>.<token-secret>" built from
# the pair below (Modal endpoints guide) — not a header pair, not a plain key.
# Create the pair with: modal workspace proxy-tokens create
TF_MODAL_KEY=
TF_MODAL_SECRET=
# Full OpenAI-compatible base INCLUDING /v1 (the SDK appends /chat/completions).
# Deployed default comes from config.yaml ai.base_url (the Modal endpoint).
# Override back to Meta direct with:
# TF_META_BASE_URL=https://api.meta.ai/v1
TF_META_BASE_URL=
# Model id MUST equal what the Modal endpoint serves — confirm with:
#   curl -s "$TF_META_BASE_URL/models" -H "Authorization: Bearer $TF_MODAL_KEY.$TF_MODAL_SECRET"
# (config.yaml ships the served id as the default; legacy Spark ids are
# auto-mapped to it when the Modal pair is set)
TF_META_SPARK_MODEL=
# Meta-direct key for live transcription/vision. The Modal endpoint serves
# chat only: leave this empty and voice degrades cleanly to the typed-
# transcript fallback, SAM stays a stub, humans decide.
TF_META_API_KEY=
TF_META_CONTRIBUTOR_MODEL=muse-spark-1.3-contributor
TF_META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
TF_META_SAM_MODEL=sam-3.1

# Paddle provider gate (only supported value today)
TF_PAYMENTS_PROVIDER=paddle_sandbox
