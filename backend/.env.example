# Trackfud backend — copy to `.env` and fill in. Every key maps to an
# os.Getenv read in backend/internal/config/config.go. Safe to commit this
# file WITHOUT secrets; never commit a filled `.env`.

# Postgres (PostGIS). Compose default:
DATABASE_URL=postgres://Trackfud:Trackfud@localhost:5432/Trackfud?sslmode=disable
# Optional: alternate config file path (default: config.yaml next to binary)
# TB_CONFIG=config.yaml
# Optional: listen addr (default :8080) and demo mode (default true)
# TB_ADDR=:8080
TB_DEMO_MODE=true

# Auth: MUST be >= 32 chars in any shared/demo environment
TB_JWT_SECRET=dev-only-change-me-32chars-minimum!!

# Paddle sandbox webhook HMAC secret. Webhook refuses everything while empty.
TB_PADDLE_WEBHOOK_SECRET=

# Local upload dir (R2-shaped contract, local disk in dev)
TB_UPLOAD_DIR=data/uploads

# SMTP for Brevo in prod; Mailpit locally (compose exposes 1025/8025)
TB_SMTP_HOST=localhost
TB_SMTP_PORT=1025

# Google Routes API (server key, restricted to server IP). Empty = offline
# planning-speed estimate fallback.
TB_GOOGLE_MAPS_KEY=

# --- AI (Meta Model API or Modal-hosted OpenAI-compatible endpoint) ---
# Key never leaves the server. Empty = deterministic offline fallbacks.
TB_META_API_KEY=
# Default: https://api.meta.ai/v1
# Modal-hosted muse-spark-open (needs proxy token as TB_META_API_KEY):
# TB_META_BASE_URL=https://muhammad099x-work--ep-muse-spark-open-816b-a42b-server.us-west.modal.direct
TB_META_BASE_URL=https://api.meta.ai/v1
# Model ids — must match what the configured BaseURL actually serves.
TB_META_SPARK_MODEL=muse-spark-1.3
TB_META_CONTRIBUTOR_MODEL=muse-spark-1.3-contributor
TB_META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
TB_META_SAM_MODEL=sam-3.1

# Paddle provider gate (only supported value today)
TB_PAYMENTS_PROVIDER=paddle_sandbox
