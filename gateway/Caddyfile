:80 {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy tf-backend:8080
	}
	handle /back-office/* {
		reverse_proxy tf-back-office:80
	}
	handle /customer/* {
		reverse_proxy tf-customer:80
	}
	handle /courier/* {
		reverse_proxy tf-courier:80
	}
	handle /merchant/* {
		reverse_proxy tf-merchant:80
	}
	respond "Trackfud gateway: open /back-office/ /customer/ /courier/ /merchant/" 200
}
